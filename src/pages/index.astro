---
// src/pages/index.astro
import Layout from "../layouts/Layout.astro";

import LinkNoDisponible from "../components/LinkNoDisponible.astro";
import Portada from "../components/Portada.astro";
import NombresFlores from "../components/NombresFlores.astro";
import Pase from "../components/Pase.astro";
import { INVITADO_MUESTRA } from "../scripts/invitado";
import Contador from "../components/Contador.astro";
import NombresPadres from "../components/NombresPadres.astro";
import Calendario from "../components/Calendario.astro";
import DirecionCeremonia from "../components/DireccionCeremonia.astro";
// import DirecionRecepcion from "../components/DireccionRecepcion.astro"; // oculto: la recepción es en el mismo lugar que la ceremonia
import Itinerario from "../components/Itinerario.astro";
import CodigoVestimenta from "../components/CodigoVestimenta.astro";
import Restriccion from "../components/Restriccion.astro";
import SugerenciaRegalo from "../components/SugerenciaRegalo.astro";
import Fotos2 from "../components/Fotos2.astro";
import Agradecimiento from "../components/Agradecimiento.astro";
import Confirmar from "../components/Confirmar.astro";
import Despedida from "../components/Despedida.astro";
---

<Layout title="Boda de Paulo y Kimberly">
    <LinkNoDisponible />
    <Portada />
    <NombresFlores />
    <Pase numeroPases={INVITADO_MUESTRA.pases} nombreInvitado={INVITADO_MUESTRA.nombre} />
    <Contador />
    <NombresPadres />
    <Calendario />
    <DirecionCeremonia />
    {/* <DirecionRecepcion /> */}
    <Itinerario />
    <CodigoVestimenta />
    <Restriccion />
    <SugerenciaRegalo />
    <Fotos2 />
    <Agradecimiento />
    <Confirmar />
    <Despedida />
</Layout>
