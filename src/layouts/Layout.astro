---
// src/layouts/Layout.astro
import "../styles/global.css";
export interface Props {
  title: string;
}
const { title } = Astro.props;

// Vista previa al compartir el link (WhatsApp, Facebook, etc.)
const descripcion =
  "Sábado 5 de diciembre de 2026 · Salón de Eventos Hacienda Emma, Tiquipaya. ¡Te esperamos!";
const urlSitio = new URL(Astro.url.pathname, Astro.site).href;
const imagenPreview = new URL("/imagenes/og-portada-4.jpg", Astro.site).href;
---

<!doctype html>
<html lang="es" class="m-0 p-0">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="only light" />
    <link rel="icon" type="image/png" href="/iconos/Anillos.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={descripcion} />

    <!-- Vista previa al compartir (Open Graph): imagen 1200x630 -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_BO" />
    <meta property="og:url" content={urlSitio} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:image" content={imagenPreview} />
    <meta property="og:image:secure_url" content={imagenPreview} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Invitación a la boda de Paulo y Kimberly" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={imagenPreview} />
    <link
      rel="preload"
      href="/fonts/GreatVibes-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <!-- Sin Google Fonts: todas las letras que se ven salen de /fonts/ del propio sitio -->

    <style>
      /* FORZAR MODO CLARO - DESHABILITAR MODO OSCURO */
      :root {
        color-scheme: only light;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        color-scheme: only light;
      }

      html {
        width: 100%;
        height: 100%;
        overflow-x: hidden;
        color-scheme: only light;
      }

      body {
        margin: 0;
        padding: 0;
        width: 100%;
        min-height: 100vh;
        overflow-x: hidden;
        color-scheme: only light;
        position: relative;
        background-color: #ffffff;
        background-image: linear-gradient(#fff, #fff);
      }

      /* FONDO CLARO ESTÁTICO PARA TODOS LOS COMPONENTES */
      body::before {
        content: "";
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-image: url("/imagenes/BlancoTextura.webp");
        background-repeat: no-repeat;
        background-position: center center;
        background-size: 100% 100%; /* ancho igual a la pantalla; en celulares largos se estira solo de alto */
        opacity: 0.1;
        z-index: 0;
        pointer-events: none;
      }

      main {
        position: relative;
        z-index: 1;
        background: transparent !important;
      }

      /* Prevenir cualquier cambio de color por modo oscuro */
      @media (prefers-color-scheme: dark) {
        :root {
          color-scheme: only light !important;
        }

        html,
        body {
          background-color: white !important;
          color: inherit !important;
        }

        * {
          color-scheme: only light !important;
        }
      }
    </style>
  </head>
  <body class="min-h-screen m-0 p-0">
    <main class="m-0 p-0 overflow-x-hidden">
      <slot />
    </main>
    <script is:inline>
      // Modelo de muestra: los botones con "#" no hacen nada (ni saltan arriba)
      document.addEventListener("click", (e) => {
        if (e.target.closest && e.target.closest('a[href="#"]')) e.preventDefault();
      });
    </script>
  </body>
</html>
