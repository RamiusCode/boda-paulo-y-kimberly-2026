---
// Restriccion.astro — Solo adultos
---

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 🥂 SECCIÓN: SOLO ADULTOS                                     -->
<!-- ═══════════════════════════════════════════════════════════ -->
<section class="relative w-full pt-6 pb-12 px-6 overflow-hidden" id="seccion-adultos">

    <!-- FLOR DERECHA -->
    <img
        src="/imagenes/costado-der.png"
        alt="Decoración floral"
        class="sa-flor absolute right-0 top-[10%] w-20 sm:w-24 z-20 pointer-events-none select-none"
        data-entrada="der"
    />

    <div class="relative z-10 flex flex-col items-center text-center max-w-xs mx-auto">

        <!-- ÍCONO dentro de un doble aro dorado -->
        <div class="sa-icono mb-4" id="icono-adultos" data-entrada="giro">
            <svg viewBox="0 0 100 100" fill="none" aria-hidden="true">
                <circle class="sa-fondo" cx="50" cy="50" r="40"></circle>
                <circle class="sa-aro" pathLength="1" cx="50" cy="50" r="47"></circle>
                <circle class="sa-aro sa-aro-fino" pathLength="1" cx="50" cy="50" r="42"></circle>
            </svg>
            <img
                src="/imagenes/restriccion.png"
                alt="Solo adultos"
                class="w-14 h-14 object-contain relative"
                style="filter: brightness(0) saturate(100%) invert(45%) sepia(30%) saturate(600%) hue-rotate(30deg) brightness(78%) drop-shadow(0 0 0.5px #556b2f) drop-shadow(0 0 0.5px #556b2f);"
            />
        </div>

        <!-- TÍTULO -->
        <h2
            class="sa-titulo titulo-seccion mb-5"
            data-entrada="desenfoque"
        >
            Solo Adultos
        </h2>

        <!-- TARJETA CON EL MENSAJE -->
        <div class="sa-tarjeta w-full" data-entrada="abajo">
            <p class="font-mollen-light text-[#556b2f]/90 text-base leading-relaxed" data-entrada="izq">
                Aunque amamos a sus pequeños, este día especial es solo para adultos.
            </p>

            <!-- Separador -->
            <div class="flex items-center justify-center gap-2 my-4" aria-hidden="true">
                <span class="sa-linea" data-entrada="centro"></span>
                <span class="sa-punto"></span>
                <span class="sa-linea sa-linea-der" data-entrada="centro"></span>
            </div>

            <p class="font-mollen-light text-[#556b2f]/80 text-sm leading-relaxed" data-entrada="der">
                Queremos que se regalen una noche de descanso y celebración, y que disfruten con nosotros cada momento.
            </p>

            <p class="font-great-vibes-local text-[#b5975f] text-2xl leading-tight mt-5" data-entrada="desenfoque">
                Agradecemos su comprensión
            </p>
        </div>
    </div>
</section>

<style>
    .sa-icono {
        position: relative;
        width: 6.25rem;
        height: 6.25rem;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .sa-icono svg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        transform: rotate(-90deg);
    }
    /* Ícono "no niños" más visible: verde olivo, aros gruesos y fondo marfil */
    .sa-fondo {
        fill: #f7f0e3;
        stroke: none;
    }
    .sa-aro {
        stroke: #556b2f;
        stroke-width: 2.4;
        stroke-dasharray: 1;
    }
    .sa-aro-fino {
        stroke: #a8874f;
        stroke-width: 1.2;
    }

    /* Título con brillo dorado, como los nombres */
    .sa-titulo {
        padding: 0 0.2em;
        background: linear-gradient(
            110deg,
            #a8874f 0%,
            #b5975f 35%,
            #d6c096 48%,
            #b5975f 60%,
            #a8874f 100%
        );
        background-size: 250% 100%;
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        filter: drop-shadow(0 2px 0 rgba(54, 67, 27, 0.14))
            drop-shadow(0 8px 12px rgba(54, 67, 27, 0.14));
        animation: sa-brillo 7s ease-in-out infinite;
    }
    @keyframes sa-brillo {
        0%,
        100% {
            background-position: 100% 0;
        }
        50% {
            background-position: 0% 0;
        }
    }

    /* Tarjeta de vidrio con borde dorado fino */
    .sa-tarjeta {
        position: relative;
        padding: 1.75rem 1.4rem 1.5rem;
        border-radius: 18px;
        border: 1px solid rgba(168, 135, 79, 0.45);
        background: linear-gradient(160deg, rgba(247, 240, 227, 0.85), rgba(255, 252, 246, 0.7));
        box-shadow:
            0 22px 40px -22px rgba(54, 67, 27, 0.24),
            0 0 24px -10px rgba(194, 163, 111, 0.3),
            inset 0 1px 0 rgba(255, 255, 255, 0.15);
    }
    .sa-tarjeta::before {
        content: "";
        position: absolute;
        inset: 6px;
        border-radius: 13px;
        border: 1px solid rgba(168, 135, 79, 0.18);
        pointer-events: none;
    }

    .sa-linea {
        display: block;
        height: 1px;
        width: 3rem;
        background: linear-gradient(90deg, transparent, rgba(168, 135, 79, 0.85));
        transform-origin: 100% 50%;
    }
    .sa-linea-der {
        background: linear-gradient(90deg, rgba(168, 135, 79, 0.85), transparent);
        transform-origin: 0% 50%;
    }
    .sa-punto {
        width: 4px;
        height: 4px;
        border-radius: 9999px;
        background: #556b2f;
        box-shadow: 0 0 6px rgba(85, 107, 47, 0.8);
    }

    .sa-flor {
        transform-origin: 100% 0%;
        filter: drop-shadow(0 12px 16px rgba(54, 67, 27, 0.14));
    }

    @media (prefers-reduced-motion: reduce) {
        .sa-titulo {
            animation: none;
        }
    }
</style>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 🎬 ANIMACIONES CON GSAP                                     -->
<!-- ═══════════════════════════════════════════════════════════ -->
<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    import { animarEntradas, sinMovimiento } from "../scripts/entradas";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        const seccion = document.getElementById("seccion-adultos");
        if (!seccion) return;

        animarEntradas(seccion);

        // Los aros dorados se dibujan
        gsap.fromTo(
            "#icono-adultos .sa-aro",
            { strokeDashoffset: 1 },
            {
                strokeDashoffset: 0,
                duration: 1.8,
                stagger: 0.2,
                ease: "power2.inOut",
                scrollTrigger: {
                    trigger: "#icono-adultos",
                    start: "top 90%",
                    toggleActions: "play none none reset",
                },
            },
        );

        if (!sinMovimiento()) {
            gsap.to(seccion.querySelector(".sa-flor"), {
                rotation: -3,
                duration: 3.8,
                ease: "sine.inOut",
                yoyo: true,
                repeat: -1,
                delay: 1.2,
            });
        }
    });
</script>
