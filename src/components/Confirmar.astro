---
// Confirmar.astro
// El botón abre la ventana de confirmación con el nombre del invitado y sus pases.
// Por ahora es solo el diseño con un invitado de muestra (src/scripts/invitado.ts).
// Cuando se conecte al sistema, el nombre y los pases llegan desde la base y la
// respuesta se envía en la función enviarRespuesta del script de abajo.
import { INVITADO_MUESTRA } from "../scripts/invitado";
import { frasePasesReservados } from "../scripts/pases";

const invitado = INVITADO_MUESTRA;
const frase = frasePasesReservados(invitado.pases);
// Un círculo por pase para elegir cuántos asisten (hasta 8)
const opcionesCantidad = Array.from({ length: Math.min(invitado.pases, 8) }, (_, i) => i + 1);
---

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 💬 SECCIÓN: CONFIRMA TU ASISTENCIA                          -->
<!-- ═══════════════════════════════════════════════════════════ -->
<section class="relative w-full pt-10 pb-14 px-6 overflow-hidden" id="seccion-confirmar">

    <!-- COSTADITO DERECHA (decoración floral) -->
    <img
        src="/imagenes/costado-der.png"
        alt="Decoración floral"
        class="absolute -right-10 top-1/2 w-24 sm:w-28 z-0 pointer-events-none select-none rotate-6"
        id="costadito-confirmar"
    />

    <!-- CONTENIDO CENTRADO -->
    <div class="relative z-10 flex flex-col items-center text-center max-w-xs mx-auto">

        <!-- MENSAJE -->
        <p
            class="font-mollen-light text-[#556b2f]/90 text-base sm:text-lg leading-relaxed mb-3"
            id="texto-confirmar"
        >
            Tu presencia hará de este día un momento inolvidable, y nos llenaría de alegría poder compartirlo contigo.
        </p>
        <p
            class="font-jane-light uppercase tracking-[0.15em] text-[#a8874f] text-base sm:text-lg leading-relaxed mb-4"
            id="subtexto-confirmar"
        >
            Por favor, confírmanos tu asistencia
        </p>

        <!-- FECHA LÍMITE PARA CONFIRMAR -->
        <!-- Rectángulo con trazo champán; angosto para que la flor de la derecha no lo tape -->
        <div class="cf-limite mb-8" id="fecha-limite-confirmar">
            <svg class="w-6 h-6 text-[#a8874f] mb-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3.5" y="5" width="17" height="15" rx="2"></rect>
                <path d="M3.5 9.5h17M8 3v4M16 3v4"></path>
                <path d="M12 17.2s-2.6-1.6-2.6-3.3c0-.8.6-1.4 1.3-1.4.6 0 1 .3 1.3.8.3-.5.7-.8 1.3-.8.7 0 1.3.6 1.3 1.4 0 1.7-2.6 3.3-2.6 3.3z" fill="currentColor" stroke="none"></path>
            </svg>
            <p class="font-jane-light uppercase tracking-[0.15em] text-[#a8874f] text-sm leading-relaxed">
                Hasta antes del
            </p>
            <p class="font-jane-light uppercase tracking-[0.15em] text-[#556b2f] text-base leading-relaxed">
                lunes 16 de noviembre
            </p>
        </div>

        <!-- BOTÓN CONFIRMAR: abre la ventana -->
        <button
            type="button"
            class="inline-flex items-center justify-center gap-3 px-8 py-3.5 rounded-xl
                   bg-gradient-to-b from-[#6f8440] to-[#4f6329] text-white
                   font-jane-light text-base uppercase tracking-[0.15em]
                   border border-[#556b2f]/20 shadow-lg cursor-pointer
                   transition-all duration-300 hover:scale-105 active:scale-95"
            id="btn-confirmar"
            aria-haspopup="dialog"
            aria-controls="cf-modal"
        >
            <svg class="w-5 h-5 text-white shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                <path d="M3.5 6l8.5 7 8.5-7"></path>
            </svg>
            <span>Confirmar asistencia</span>
        </button>

    </div>
</section>

<!-- ═══ VENTANA DE CONFIRMACIÓN ═══ -->
<div
    class="cf-modal"
    id="cf-modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="cf-nombre"
    data-nombre={invitado.nombre}
    data-pases={invitado.pases}
    hidden
>
    <div class="cf-tarjeta" id="cf-tarjeta">
        <span class="cf-linea-interior" aria-hidden="true"></span>

        <button type="button" class="cf-cerrar" id="cf-cerrar" aria-label="Cerrar">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
                <path d="M6 6l12 12M18 6L6 18"></path>
            </svg>
        </button>

        <!-- PASO 1: datos del invitado y respuesta -->
        <div class="cf-paso text-center" id="cf-formulario">
            <p class="font-jane-light uppercase tracking-[0.15em] text-[#a8874f] text-sm">
                Confirmación de asistencia
            </p>
            <h3 class="font-jane-light uppercase tracking-[0.12em] text-[#556b2f] text-2xl leading-snug mt-3" id="cf-nombre">
                {invitado.nombre}
            </h3>

            <!-- Separador con rombo -->
            <div class="flex items-center justify-center gap-2 mt-3 mb-4" aria-hidden="true">
                <span class="cf-linea"></span>
                <span class="cf-rombo"></span>
                <span class="cf-linea cf-linea-der"></span>
            </div>

            <p class="font-mollen-light text-[#556b2f] text-base">
                {frase.antes} <strong class="cf-resaltado">{frase.numero}</strong> {frase.despues}
            </p>

            <p class="font-jane-light uppercase tracking-[0.15em] text-[#a8874f] text-xs mt-5 mb-3">
                ¿Cuántos asistirán?
            </p>
            <div class="cf-cantidades" role="radiogroup" aria-label="¿Cuántos asistirán?">
                {
                    opcionesCantidad.map((n) => (
                        <button
                            type="button"
                            class="cf-cantidad font-mb-deco"
                            role="radio"
                            aria-checked={n === invitado.pases ? "true" : "false"}
                            data-cantidad={n}
                        >
                            {n}
                        </button>
                    ))
                }
            </div>

            <button type="button" class="cf-principal font-jane-light" id="cf-confirmar">
                Confirmar asistencia
            </button>
            <button type="button" class="cf-no font-mollen-light" id="cf-no-asistire">
                No podré asistir
            </button>

            <!-- ¿ESTÁS SEGURO? (aparece antes de enviar) -->
            <div class="cf-seguro" id="cf-seguro" hidden>
                <p class="font-great-vibes-local text-[#a8874f] text-3xl leading-tight">
                    ¿Estás seguro?
                </p>
                <p class="font-mollen-light text-[#556b2f]/90 text-sm leading-relaxed mt-2" id="cf-seguro-texto"></p>
                <div class="cf-seguro-botones">
                    <button type="button" class="cf-corregir font-jane-light" id="cf-corregir">Corregir</button>
                    <button type="button" class="cf-enviar font-jane-light" id="cf-si-enviar">Sí, enviar</button>
                </div>
            </div>
        </div>

        <!-- PASO 2: agradecimiento -->
        <div class="cf-gracias text-center" id="cf-gracias" hidden>
            <svg class="cf-gracias-icono" viewBox="0 0 48 44" fill="none" aria-hidden="true">
                <path pathLength="1" d="M24 40C24 40 4 27 4 14.5C4 8 9 3.5 14.5 3.5C18.6 3.5 22 6 24 9.5C26 6 29.4 3.5 33.5 3.5C39 3.5 44 8 44 14.5C44 27 24 40 24 40Z"></path>
            </svg>
            <h3 class="font-great-vibes-local text-[#a8874f] text-4xl leading-tight mt-3">
                ¡Gracias!
            </h3>
            <p class="font-mollen-light text-[#556b2f]/90 text-base leading-relaxed mt-3" id="cf-gracias-texto"></p>
            <button type="button" class="cf-principal font-jane-light" id="cf-listo">
                Listo
            </button>
        </div>
    </div>
</div>

<style>
    /* Fecha límite dentro de un rectángulo de trazo champán, con línea interior */
    .cf-limite {
        position: relative;
        display: inline-flex;
        flex-direction: column;
        align-items: center;
        max-width: 15.5rem;
        padding: 0.9rem 1.4rem 1rem;
        border: 1px solid rgba(168, 135, 79, 0.75);
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.55);
    }
    .cf-limite::before {
        content: "";
        position: absolute;
        inset: 4px;
        border: 1px solid rgba(168, 135, 79, 0.25);
        border-radius: 7px;
        pointer-events: none;
    }

    /* Fondo de la ventana */
    .cf-modal {
        position: fixed;
        inset: 0;
        z-index: 200;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.25rem;
        background: rgba(30, 37, 17, 0.55);
        -webkit-backdrop-filter: blur(5px);
        backdrop-filter: blur(5px);
    }
    .cf-modal[hidden] {
        display: none;
    }

    /* Tarjeta marfil con borde champán, como las demás de la invitación */
    .cf-tarjeta {
        position: relative;
        width: 100%;
        max-width: 22rem;
        max-height: calc(100dvh - 2.5rem);
        overflow-y: auto;
        padding: 2.25rem 1.5rem 1.75rem;
        border-radius: 18px;
        border: 2px solid #c2a36f;
        background: linear-gradient(160deg, #fffdf8, #f7f0e3);
        box-shadow: 0 30px 60px -20px rgba(30, 37, 17, 0.45);
    }
    .cf-linea-interior {
        position: absolute;
        inset: 6px;
        border-radius: 12px;
        border: 1px solid rgba(194, 163, 111, 0.35);
        pointer-events: none;
    }
    .cf-cerrar {
        position: absolute;
        top: 0.7rem;
        right: 0.7rem;
        z-index: 1;
        width: 2.1rem;
        height: 2.1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        color: #a8874f;
        border: 1px solid rgba(168, 135, 79, 0.55);
        background: #ffffff;
        cursor: pointer;
    }
    .cf-cerrar svg {
        width: 1.1rem;
        height: 1.1rem;
    }

    .cf-linea {
        display: block;
        height: 1px;
        width: 3.5rem;
        background: linear-gradient(90deg, transparent, rgba(168, 135, 79, 0.85));
    }
    .cf-linea-der {
        background: linear-gradient(90deg, rgba(168, 135, 79, 0.85), transparent);
    }
    .cf-rombo {
        width: 6px;
        height: 6px;
        transform: rotate(45deg);
        border: 1px solid #a8874f;
    }
    .cf-resaltado {
        font-weight: 700;
        color: #3f4f20;
    }

    /* Círculos para elegir cuántos asisten */
    .cf-cantidades {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.6rem;
    }
    .cf-cantidad {
        width: 2.9rem;
        height: 2.9rem;
        border-radius: 9999px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.35rem;
        color: #556b2f;
        background: #ffffff;
        border: 1.5px solid rgba(85, 107, 47, 0.55);
        cursor: pointer;
        transition: all 0.25s ease;
    }
    .cf-cantidad[aria-checked="true"] {
        color: #ffffff;
        background: radial-gradient(circle at 50% 35%, #6f8440, #4f6329);
        border-color: #4f6329;
        box-shadow: 0 0 0 3px #f7f0e3, 0 0 0 4.5px #c2a36f, 0 8px 14px -6px rgba(54, 67, 27, 0.6);
    }

    /* Botón principal en verde olivo con borde champán */
    .cf-principal {
        width: 100%;
        margin-top: 1.6rem;
        padding: 0.9rem 1rem;
        border-radius: 9999px;
        font-size: 0.9rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: #ffffff;
        background: linear-gradient(180deg, #6f8440, #4f6329);
        border: 2px solid #c2a36f;
        box-shadow: 0 10px 20px -10px rgba(54, 67, 27, 0.6);
        cursor: pointer;
        transition: transform 0.15s ease, opacity 0.2s ease;
    }
    .cf-principal:active {
        transform: scale(0.97);
    }

    /* "No podré asistir": enlace subrayado, discreto */
    .cf-no {
        display: inline-block;
        margin-top: 1rem;
        font-size: 0.95rem;
        color: #8a7a68;
        text-decoration: underline;
        text-underline-offset: 4px;
        text-decoration-color: rgba(138, 122, 104, 0.6);
        cursor: pointer;
    }

    /* "¿Estás seguro?": aparece debajo antes de enviar */
    .cf-seguro {
        margin-top: 1.25rem;
        padding: 1rem;
        border-radius: 12px;
        text-align: center;
        background: rgba(168, 135, 79, 0.08);
        border: 1px dashed rgba(168, 135, 79, 0.6);
    }
    .cf-seguro-botones {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.6rem;
        margin-top: 0.9rem;
    }
    .cf-enviar,
    .cf-corregir {
        padding: 0.75rem 0.5rem;
        border-radius: 12px;
        font-size: 0.8rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        cursor: pointer;
    }
    .cf-enviar {
        color: #ffffff;
        background: linear-gradient(180deg, #c4a774, #a8874f);
        border: 1px solid rgba(168, 135, 79, 0.4);
    }
    .cf-enviar:disabled {
        opacity: 0.7;
        cursor: default;
    }
    .cf-corregir {
        color: #a8874f;
        background: #ffffff;
        border: 1.5px solid rgba(168, 135, 79, 0.7);
    }

    .cf-gracias-icono {
        width: 3rem;
        height: auto;
        margin: 0 auto;
    }
    .cf-gracias-icono path {
        stroke: #a8874f;
        stroke-width: 1.5;
        stroke-dasharray: 1;
    }
</style>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 🎬 ANIMACIONES CON GSAP                                     -->
<!-- ═══════════════════════════════════════════════════════════ -->
<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    import { textoPersonas } from "../scripts/pases";

    gsap.registerPlugin(ScrollTrigger);

    // Envía la respuesta. Por ahora es solo diseño: cuando se conecte al sistema
    // de invitados, acá se manda la confirmación a la base.
    async function enviarRespuesta(_datos: { nombre: string; asistira: boolean; cantidad: number }) {
        return;
    }

    document.addEventListener("DOMContentLoaded", () => {
        const tl = gsap.timeline({
            scrollTrigger: {
                trigger: "#seccion-confirmar",
                start: "top 85%",
                toggleActions: "play none none reset",
            },
        });

        tl.fromTo(
            "#costadito-confirmar",
            { opacity: 0, x: 40 },
            { opacity: 1, x: 0, duration: 1.2, ease: "power2.out" },
            0,
        )
        .fromTo(
            ["#texto-confirmar", "#subtexto-confirmar", "#fecha-limite-confirmar"],
            { opacity: 0, y: 20 },
            { opacity: 1, y: 0, duration: 0.9, stagger: 0.15, ease: "sine.out" },
            0.3,
        )
        .fromTo(
            "#btn-confirmar",
            { opacity: 0, scale: 0.9 },
            { opacity: 1, scale: 1, duration: 0.8, ease: "back.out(1.4)" },
            0.6,
        );

        // Pulso suave del botón
        gsap.to("#btn-confirmar", {
            scale: 1.04,
            duration: 1.4,
            ease: "sine.inOut",
            yoyo: true,
            repeat: -1,
            delay: 1.6,
        });

        // ═══ VENTANA DE CONFIRMACIÓN ═══
        const modal = document.getElementById("cf-modal");
        const tarjeta = document.getElementById("cf-tarjeta");
        const paso1 = document.getElementById("cf-formulario");
        const gracias = document.getElementById("cf-gracias");
        const seguro = document.getElementById("cf-seguro");
        const textoSeguro = document.getElementById("cf-seguro-texto");
        const textoGracias = document.getElementById("cf-gracias-texto");
        const botonConfirmar = document.getElementById("cf-confirmar");
        const botonNo = document.getElementById("cf-no-asistire");
        const botonSiEnviar = document.getElementById("cf-si-enviar") as HTMLButtonElement | null;
        const cantidades = Array.from(document.querySelectorAll<HTMLButtonElement>(".cf-cantidad"));
        if (!modal || !tarjeta || !paso1 || !gracias || !seguro) return;

        const nombre = modal.dataset.nombre ?? "";
        const pases = Number(modal.dataset.pases ?? 1);
        let cantidad = pases;
        let asistira = true;
        let overflowPrevio = "";

        const marcarCantidad = (n: number) => {
            cantidad = n;
            cantidades.forEach((c) =>
                c.setAttribute("aria-checked", String(Number(c.dataset.cantidad) === n)),
            );
        };

        const ocultarSeguro = () => {
            seguro.hidden = true;
            if (botonConfirmar) botonConfirmar.hidden = false;
            if (botonNo) botonNo.hidden = false;
        };

        const reiniciar = () => {
            marcarCantidad(pases);
            ocultarSeguro();
            if (botonSiEnviar) botonSiEnviar.disabled = false;
            paso1.hidden = false;
            gracias.hidden = true;
        };

        const abrir = () => {
            reiniciar();
            overflowPrevio = document.body.style.overflow;
            document.body.style.overflow = "hidden";
            modal.hidden = false;
            gsap.fromTo(modal, { opacity: 0 }, { opacity: 1, duration: 0.3, ease: "power2.out" });
            gsap.fromTo(
                tarjeta,
                { opacity: 0, y: 30, scale: 0.94 },
                { opacity: 1, y: 0, scale: 1, duration: 0.5, ease: "back.out(1.3)" },
            );
        };

        const cerrar = () => {
            if (modal.hidden) return;
            gsap.to(modal, {
                opacity: 0,
                duration: 0.25,
                ease: "power2.in",
                onComplete: () => {
                    modal.hidden = true;
                    document.body.style.overflow = overflowPrevio;
                },
            });
        };

        document.getElementById("btn-confirmar")?.addEventListener("click", abrir);
        document.getElementById("cf-cerrar")?.addEventListener("click", cerrar);
        document.getElementById("cf-listo")?.addEventListener("click", cerrar);
        modal.addEventListener("click", (e) => {
            if (e.target === modal) cerrar();
        });
        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape") cerrar();
        });

        // Elegir cuántos asisten
        cantidades.forEach((c) => {
            c.addEventListener("click", () => {
                marcarCantidad(Number(c.dataset.cantidad));
                ocultarSeguro();
                gsap.fromTo(c, { scale: 0.9 }, { scale: 1, duration: 0.35, ease: "back.out(2)" });
            });
        });

        // Muestra "¿Estás seguro?" con el resumen de la respuesta
        const preguntar = (siAsiste: boolean) => {
            asistira = siAsiste;
            if (textoSeguro) {
                textoSeguro.textContent = siAsiste
                    ? `Vas a confirmar la asistencia de ${textoPersonas(cantidad)}.`
                    : "Vas a avisar que no podrán asistir.";
            }
            if (botonConfirmar) botonConfirmar.hidden = true;
            if (botonNo) botonNo.hidden = true;
            seguro.hidden = false;
            gsap.fromTo(seguro, { opacity: 0, y: 10 }, { opacity: 1, y: 0, duration: 0.35, ease: "power2.out" });
            seguro.scrollIntoView({ behavior: "smooth", block: "nearest" });
        };

        botonConfirmar?.addEventListener("click", () => preguntar(true));
        botonNo?.addEventListener("click", () => preguntar(false));
        document.getElementById("cf-corregir")?.addEventListener("click", ocultarSeguro);

        botonSiEnviar?.addEventListener("click", async () => {
            botonSiEnviar.disabled = true;
            try {
                await enviarRespuesta({ nombre, asistira, cantidad: asistira ? cantidad : 0 });
            } catch (error) {
                console.log("No se pudo enviar la confirmación:", error);
            }

            if (textoGracias) {
                textoGracias.textContent = asistira
                    ? `${nombre}, recibimos tu confirmación para ${textoPersonas(cantidad)}. ¡Te esperamos con mucho cariño!`
                    : `${nombre}, gracias por avisarnos. Te vamos a extrañar en este día tan especial.`;
            }
            paso1.hidden = true;
            gracias.hidden = false;
            gsap.fromTo(gracias, { opacity: 0, y: 12 }, { opacity: 1, y: 0, duration: 0.45, ease: "power2.out" });
            gsap.fromTo(
                "#cf-gracias .cf-gracias-icono path",
                { strokeDashoffset: 1 },
                { strokeDashoffset: 0, duration: 1.4, ease: "power2.inOut" },
            );
        });
    });
</script>
