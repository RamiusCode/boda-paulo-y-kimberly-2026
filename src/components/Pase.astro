---
// Pase.astro
import { textoEnSuHonor } from "../scripts/pases";

interface Props {
    numeroPases?: number;
    nombreInvitado?: string;
}

// Valores de muestra: se ven si el link no trae código (?i=...).
// Con código, el nombre y los pases llegan desde el sistema de invitados.
const { numeroPases = 1, nombreInvitado = "Nombre del invitado" } = Astro.props;
// Una personita por pase (hasta 8, para que no se desborde)
const personas = Array.from({ length: Math.min(numeroPases, 8) });
---

<section class="relative w-full pt-8 pb-12 px-6 overflow-hidden" id="seccion-pase">
    <div class="pa-escena relative max-w-xs mx-auto" id="card-pase">

        <!-- TARJETA -->
        <div class="pa-tarjeta" id="card-principal-pase">
            <span class="pa-linea-interior" aria-hidden="true"></span>

            <div class="relative flex flex-col items-center text-center">
                <!-- BIENVENIDA -->
                <p
                    class="font-jane-light uppercase tracking-[0.2em] text-[#a8874f] text-lg sm:text-xl"
                    id="bienvenida-pase"
                    data-entrada="abajo"
                >
                    Con mucho cariño para
                </p>

                <!-- NOMBRE DEL INVITADO (baja de renglón si es largo) -->
                <h2
                    class="pa-nombre font-jane-light uppercase leading-snug mt-4"
                    id="nombre-invitado-pase"
                    data-entrada="desenfoque"
                >
                    {nombreInvitado}
                </h2>

                <!-- SEPARADOR -->
                <div class="flex items-center justify-center gap-2 my-5" aria-hidden="true">
                    <span class="pa-linea" data-entrada="centro"></span>
                    <span class="pa-punto"></span>
                    <span class="pa-linea pa-linea-der" data-entrada="centro"></span>
                </div>

                <p class="font-mollen-light text-[#556b2f]/90 text-base" id="reservado-pase" data-entrada="abajo">
                    Hemos reservado
                </p>

                <!-- NÚMERO DE PASES -->
                <p
                    class="pa-numero font-mb-deco leading-none my-2"
                    id="numero-pase"
                    data-pases={numeroPases}
                >
                    {numeroPases}
                </p>

                <p
                    class="font-mollen-light italic text-[#556b2f]/90 text-base"
                    id="texto-pase"
                    data-entrada="abajo"
                >
                    {textoEnSuHonor(numeroPases)}
                </p>

                <!-- UNA PERSONITA POR PASE -->
                <div class="flex flex-wrap items-center justify-center gap-2 mt-6" id="personas-pase">
                    {
                        personas.map(() => (
                            <span class="pa-persona">
                                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                    <circle cx="12" cy="8" r="4"></circle>
                                    <path d="M4 20c0-4.4 3.6-7 8-7s8 2.6 8 7z"></path>
                                </svg>
                            </span>
                        ))
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .pa-escena {
        perspective: 1000px;
    }

    /* Tarjeta marfil con marco verde olivo y línea interior champán */
    .pa-tarjeta {
        position: relative;
        overflow: hidden;
        padding: 2.5rem 1.5rem 2.25rem;
        border-radius: 18px;
        border: 2px solid #556b2f;
        background: linear-gradient(160deg, rgba(255, 253, 248, 0.95), rgba(247, 240, 227, 0.9));
        box-shadow:
            0 24px 40px -24px rgba(54, 67, 27, 0.26),
            0 0 26px -10px rgba(194, 163, 111, 0.35);
        transform-style: preserve-3d;
    }
    .pa-linea-interior {
        position: absolute;
        inset: 6px;
        border-radius: 12px;
        border: 1px solid rgba(168, 135, 79, 0.55);
        pointer-events: none;
    }
    /* Nombre en verde olivo, misma letra que "Con mucho cariño para"; puede ocupar dos renglones */
    .pa-nombre {
        font-size: 1.6rem;
        letter-spacing: 0.12em;
        padding: 0 0.15em;
        overflow-wrap: break-word;
        color: #556b2f;
    }

    .pa-linea {
        display: block;
        height: 1px;
        width: 3.5rem;
        background: linear-gradient(90deg, transparent, rgba(85, 107, 47, 0.8));
        transform-origin: 100% 50%;
    }
    .pa-linea-der {
        background: linear-gradient(90deg, rgba(85, 107, 47, 0.8), transparent);
        transform-origin: 0% 50%;
    }
    .pa-punto {
        width: 5px;
        height: 5px;
        border-radius: 9999px;
        background: #a8874f;
        box-shadow: 0 0 6px rgba(168, 135, 79, 0.8);
    }

    .pa-numero {
        font-size: 4.5rem;
        color: #a8874f;
    }

    .pa-persona {
        width: 2.1rem;
        height: 2.1rem;
        border-radius: 9999px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #556b2f;
        background: #ffffff;
        border: 1.5px solid rgba(85, 107, 47, 0.6);
        box-shadow: 0 6px 12px -6px rgba(54, 67, 27, 0.21);
    }
    .pa-persona svg {
        width: 1rem;
        height: 1rem;
    }

</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    import { animarEntradas, sinMovimiento } from "../scripts/entradas";
    import { textoEnSuHonor } from "../scripts/pases";
    import { datosInvitado, alCambiarInvitado, type Invitado } from "../lib/invitado";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        const seccion = document.getElementById("seccion-pase");
        if (!seccion) return;

        const disparo = {
            trigger: "#card-pase",
            start: "top 85%",
            toggleActions: "play none none reset",
        };

        // La tarjeta se levanta en 3D, como una invitación que se abre
        gsap.fromTo(
            "#card-principal-pase",
            { opacity: 0, rotationX: 35, y: 60, transformOrigin: "50% 100%" },
            { opacity: 1, rotationX: 0, y: 0, duration: 1.3, ease: "power3.out", scrollTrigger: disparo },
        );

        animarEntradas(seccion);

        // El número cuenta desde 0 hasta la cantidad de pases.
        // `total` puede cambiar cuando llegan los datos del sistema: la cuenta
        // siempre usa el valor más reciente, para no volver a escribir el viejo.
        const numero = document.getElementById("numero-pase");
        let total = Number(numero?.dataset.pases ?? 1);
        const contador = { avance: 0 };
        gsap.fromTo(
            contador,
            { avance: 0 },
            {
                avance: 1,
                duration: 1.2,
                ease: "power2.out",
                delay: 0.9,
                scrollTrigger: disparo,
                onUpdate: () => {
                    if (numero) numero.textContent = String(Math.round(contador.avance * total));
                },
            },
        );
        gsap.fromTo(
            "#numero-pase",
            { opacity: 0, scale: 0.5 },
            { opacity: 1, scale: 1, duration: 0.8, ease: "back.out(2)", delay: 0.8, scrollTrigger: disparo },
        );

        // Las personitas aparecen (se anima el contenedor: si el sistema cambia
        // la cantidad y se regeneran, siguen apareciendo igual)
        gsap.fromTo(
            "#personas-pase",
            { opacity: 0, y: 12, scale: 0.8 },
            { opacity: 1, y: 0, scale: 1, duration: 0.6, ease: "back.out(2)", delay: 1.3, scrollTrigger: disparo },
        );

        // ═══ DATOS DEL SISTEMA DE INVITADOS ═══
        // Con ?i=codigo en el link, el nombre y los pases vienen de la base.
        // Si los novios los corrigen en el panel, la tarjeta se actualiza sola.
        const nombreEl = document.getElementById("nombre-invitado-pase");
        const textoEl = document.getElementById("texto-pase");
        const personasEl = document.getElementById("personas-pase");
        const plantillaPersona = personasEl?.querySelector(".pa-persona")?.cloneNode(true) as HTMLElement | undefined;

        const pintarPersonas = (n: number) => {
            if (!personasEl || !plantillaPersona) return;
            personasEl.replaceChildren(
                ...Array.from({ length: Math.min(n, 8) }, () => plantillaPersona.cloneNode(true)),
            );
        };

        const mostrar = (inv: Invitado | null) => {
            if (!inv) return;
            if (inv.nombre && nombreEl) nombreEl.textContent = inv.nombre;

            // Si la boda no contrató pases, la tarjeta muestra solo el nombre:
            // sin esto quedaría un "1 pase en su honor" inventado.
            const sinPases = inv.funciones?.pases === false;
            for (const id of ["reservado-pase", "numero-pase", "texto-pase", "personas-pase"]) {
                const el = document.getElementById(id);
                if (el) el.style.display = sinPases ? "none" : "";
            }
            if (sinPases) return;

            if (Number.isInteger(inv.pases) && inv.pases > 0) {
                total = inv.pases;
                if (numero) {
                    numero.dataset.pases = String(total);
                    // Si la cuenta ya terminó, se escribe el número nuevo directo
                    if (contador.avance >= 1) numero.textContent = String(total);
                }
                if (textoEl) textoEl.textContent = textoEnSuHonor(total);
                pintarPersonas(total);
            }
        };

        datosInvitado().then(mostrar);
        alCambiarInvitado((inv) => mostrar(inv));

        // Un vaivén 3D muy suave de la tarjeta
        if (!sinMovimiento()) {
            // Va en el contenedor, para no chocar con la entrada de la tarjeta
            gsap.to("#card-pase", {
                transformPerspective: 1000,
                rotationY: 4,
                rotationX: -2,
                duration: 4,
                ease: "sine.inOut",
                yoyo: true,
                repeat: -1,
                delay: 2.5,
            });
        }
    });
</script>
