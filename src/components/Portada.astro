---
// Portada.astro
---

<section
    id="portada-sobre"
    class="fixed inset-0 w-full h-[100dvh] z-50 flex items-center justify-center overflow-hidden bg-[#ffffff]"
>
    <!-- FONDO TEXTURA BLANCA (fijo, al 50%) -->
    <img
        src="/imagenes/BlancoTextura.webp"
        alt=""
        aria-hidden="true"
        class="absolute inset-0 w-full h-full object-fill opacity-10 z-0 pointer-events-none select-none"
    />

    <!-- PARTÍCULAS DE LUZ (se generan en el script) -->
    <div
        id="portada-particulas"
        class="absolute inset-0 z-[2] pointer-events-none"
    >
    </div>

    <!-- PÉTALOS QUE CAEN (se generan en el script) -->
    <div
        id="portada-petalos"
        class="absolute inset-0 z-[5] pointer-events-none"
    >
    </div>

    <!-- ADORNOS DORADOS FINOS (esquinas sin flores) -->
    <svg
        class="portada-esquina portada-esquina-der"
        viewBox="0 0 120 120"
        fill="none"
        aria-hidden="true"
    >
        <path pathLength="1" d="M116 4 H44 Q4 4 4 44 V116"></path>
        <path pathLength="1" d="M104 14 H50 Q14 14 14 50 V104"></path>
        <path pathLength="1" d="M30 30 Q40 22 46 30 Q52 38 42 42"></path>
        <circle cx="4" cy="4" r="2.2"></circle>
    </svg>
    <svg
        class="portada-esquina portada-esquina-izq"
        viewBox="0 0 120 120"
        fill="none"
        aria-hidden="true"
    >
        <path pathLength="1" d="M116 4 H44 Q4 4 4 44 V116"></path>
        <path pathLength="1" d="M104 14 H50 Q14 14 14 50 V104"></path>
        <path pathLength="1" d="M30 30 Q40 22 46 30 Q52 38 42 42"></path>
        <circle cx="4" cy="4" r="2.2"></circle>
    </svg>

    <!-- FLOR SUPERIOR (esquina superior izquierda) -->
    <img
        id="flor-arriba"
        src="/imagenes/flor-portada-arriba.png"
        alt="Flores superiores"
        class="portada-flor absolute top-0 left-0 h-[36dvh] w-auto max-w-none z-20 pointer-events-none select-none"
    />

    <!-- FLOR INFERIOR (esquina inferior derecha) -->
    <img
        id="flor-abajo"
        src="/imagenes/flor-portada-abajo.png"
        alt="Flores inferiores"
        class="portada-flor absolute bottom-0 right-0 h-[36dvh] w-auto max-w-none z-20 pointer-events-none select-none"
    />

    <!-- CONTENIDO: la escena 3D y, debajo, el botón quieto -->
    <div class="relative z-10 flex flex-col items-center w-full">
    <div id="portada-escena" class="portada-escena relative z-10">
        <div id="portada-flotante" class="portada-flotante">
            <div id="portada-marco" class="portada-contenido">

                <!-- CONTENIDO CENTRAL -->
                <div
                    class="relative flex flex-col items-center justify-center text-center w-full"
                >
                    <!-- "Nuestra boda" -->
                    <p
                        class="portada-item font-jane-light text-[#556b2f] text-xl sm:text-2xl md:text-3xl tracking-[0.18em] uppercase mb-3"
                    >
                        Nuestra boda
                    </p>

                    <!-- Separador decorativo -->
                    <div
                        class="portada-item flex items-center justify-center gap-3 mb-4 sm:mb-6"
                    >
                        <span class="portada-linea"></span>
                        <span class="portada-adorno" aria-hidden="true"><svg viewBox="0 0 24 22"><path d="M12 20.5S2 14.2 2 7.6C2 4.5 4.4 2 7.3 2c2 0 3.7 1.1 4.7 2.8C13 3.1 14.7 2 16.7 2 19.6 2 22 4.5 22 7.6c0 6.6-10 12.9-10 12.9z"/></svg></span>
                        <span class="portada-linea portada-linea-der"></span>
                    </div>

                    <!-- NOMBRES DE LOS NOVIOS -->
                    <h1 class="font-great-vibes-local leading-tight">
                        <span class="portada-item portada-nombre block"
                            >Paulo</span
                        >
                        <span
                            class="portada-item portada-y block mt-2 mb-0 relative top-1"
                            >&amp;</span
                        >
                        <span class="portada-item portada-nombre block"
                            >Kimberly</span
                        >
                    </h1>
                </div>
            </div>
        </div>

    </div>

    <!-- BOTÓN INGRESAR: fuera de la escena 3D a propósito. Dentro de una
         escena que gira, en iPhone el toque no coincide con el botón dibujado
         y a veces no responde. Acá queda quieto y responde siempre. -->
    <div id="portada-boton-caja" class="portada-item mt-7 sm:mt-9 relative z-30">
        <div id="btn-ingresar-pulso">
            <button
                id="btn-ingresar"
                class="portada-boton cursor-pointer font-mollen-light text-base sm:text-lg tracking-wide focus:outline-none"
            >
                <span class="relative z-[1]"
                    >Ingresar a mi invitación</span
                >
            </button>
        </div>
    </div>
    </div>
</section>

<script>
    import { gsap } from "gsap";

    document.addEventListener("DOMContentLoaded", () => {
        const btnIngresar = document.getElementById("btn-ingresar");
        const portada = document.getElementById("portada-sobre");
        const capaParticulas = document.getElementById("portada-particulas");
        if (!portada) return;

        const sinMovimiento = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
        ).matches;

        // ═══ PARTÍCULAS DE LUZ ═══
        const particulas: HTMLElement[] = [];
        const cantidad = window.innerWidth < 640 ? 18 : 30;
        for (let i = 0; i < cantidad; i++) {
            const p = document.createElement("span");
            const tam = gsap.utils.random(2, 6);
            p.className = "portada-particula";
            p.style.width = `${tam}px`;
            p.style.height = `${tam}px`;
            p.style.left = `${gsap.utils.random(0, 100)}%`;
            p.style.top = `${gsap.utils.random(0, 100)}%`;
            p.dataset.prof = String(tam / 6);
            capaParticulas?.appendChild(p);
            particulas.push(p);
        }

        // ═══ ANIMACIÓN DE ENTRADA ═══
        gsap.set("#portada-escena", { transformPerspective: 1200 });
        gsap.set("#portada-sobre .portada-item", { transformPerspective: 600 });
        const tl = gsap.timeline({ delay: 0.2 });

        tl.from(
            "#portada-marco",
            {
                opacity: 0,
                y: 60,
                z: -260,
                rotationX: 28,
                duration: 1.8,
                ease: "power3.out",
            },
            0.15,
        );

        // Flor superior: entra desde su lado (arriba-izquierda)
        tl.from(
            "#flor-arriba",
            {
                opacity: 0,
                x: -120,
                y: -120,
                rotation: -12,
                scale: 0.8,
                duration: 2,
                ease: "power3.out",
            },
            0.3,
        );

        // Flor inferior: entra desde su lado (abajo-derecha)
        tl.from(
            "#flor-abajo",
            {
                opacity: 0,
                x: 120,
                y: 120,
                rotation: 12,
                scale: 0.8,
                duration: 2,
                ease: "power3.out",
            },
            0.3,
        );

        // Textos: uno tras otro, como si salieran del arco
        tl.from(
            "#portada-sobre .portada-item",
            {
                opacity: 0,
                y: 24,
                z: -80,
                rotationX: -35,
                duration: 1.1,
                stagger: 0.14,
                ease: "back.out(1.6)",
            },
            0.7,
        );

        tl.from(
            particulas,
            { opacity: 0, duration: 1.5, stagger: 0.03 },
            0.5,
        );

        // Esquinas: el trazo dorado se dibuja solo
        tl.fromTo(
            "#portada-sobre .portada-esquina path",
            { strokeDashoffset: 1 },
            {
                strokeDashoffset: 0,
                duration: 2.4,
                stagger: 0.15,
                ease: "power2.inOut",
            },
            0.6,
        );
        tl.from(
            "#portada-sobre .portada-esquina circle",
            { opacity: 0, scale: 0, transformOrigin: "50% 50%", duration: 0.6 },
            2,
        );

        // ═══ HOJAS QUE CAEN (verde oliva suave) ═══
        const capaPetalos = document.getElementById("portada-petalos");
        const coloresPetalo = ["#a3ad7c", "#95a26b", "#b0b98d", "#8b9862", "#9fab78"];
        if (capaPetalos && !sinMovimiento) {
            const cantidadPetalos = window.innerWidth < 640 ? 9 : 14;
            for (let i = 0; i < cantidadPetalos; i++) {
                const petalo = document.createElement("span");
                const tam = gsap.utils.random(9, 16);
                petalo.className = "portada-petalo";
                petalo.style.width = `${tam}px`;
                petalo.style.height = `${tam * 1.35}px`;
                petalo.style.left = `${gsap.utils.random(0, 100)}%`;
                // Hoja con nervadura central y dos nervios laterales
                petalo.innerHTML = `<svg viewBox="0 0 20 27"><path d="M10 0C17 6 18 17 10 27C2 17 3 6 10 0Z" fill="${gsap.utils.random(coloresPetalo)}"/><path d="M10 3.5V25M10 11L6.2 8M10 11L13.8 8M10 17L5.8 13.8M10 17L14.2 13.8" stroke="rgba(255,255,255,0.45)" stroke-width="0.7" stroke-linecap="round" fill="none"/></svg>`;
                capaPetalos.appendChild(petalo);

                const caida = gsap.utils.random(11, 19);
                const espera = gsap.utils.random(1, 6);
                gsap.fromTo(
                    petalo,
                    { y: -40, rotation: gsap.utils.random(0, 360) },
                    {
                        y: window.innerHeight + 60,
                        rotation: `+=${gsap.utils.random(-300, 300)}`,
                        duration: caida,
                        ease: "none",
                        repeat: -1,
                        delay: espera,
                    },
                );
                gsap.to(petalo, {
                    x: gsap.utils.random(-60, 60),
                    rotationY: 180,
                    duration: gsap.utils.random(2.5, 4.5),
                    ease: "sine.inOut",
                    yoyo: true,
                    repeat: -1,
                });
                gsap.fromTo(
                    petalo,
                    { opacity: 0 },
                    {
                        opacity: gsap.utils.random(0.6, 0.9),
                        duration: 1.5,
                        delay: espera,
                    },
                );
            }
        }

        if (!sinMovimiento) {
            // Partículas: suben flotando y titilan
            particulas.forEach((p) => {
                gsap.to(p, {
                    y: gsap.utils.random(-140, -60),
                    x: gsap.utils.random(-30, 30),
                    duration: gsap.utils.random(5, 10),
                    ease: "sine.inOut",
                    yoyo: true,
                    repeat: -1,
                    delay: gsap.utils.random(0, 3),
                });
                gsap.to(p, {
                    opacity: gsap.utils.random(0.15, 0.4),
                    duration: gsap.utils.random(1.2, 2.8),
                    ease: "sine.inOut",
                    yoyo: true,
                    repeat: -1,
                });
            });

            // Flotación suave del arco (respira en 3D aunque nadie lo toque)
            gsap.to("#portada-flotante", {
                rotationY: 4,
                rotationX: -2,
                y: -6,
                duration: 4,
                ease: "sine.inOut",
                yoyo: true,
                repeat: -1,
            });


            // Pulso suave del botón (invita a hacer click)
            gsap.to("#btn-ingresar-pulso", {
                scale: 1.05,
                duration: 1.1,
                ease: "sine.inOut",
                yoyo: true,
                repeat: -1,
                delay: 2.5,
            });

            // ═══ PROFUNDIDAD 3D: sigue al mouse, al dedo o a la inclinación ═══
            const rotY = gsap.quickTo("#portada-escena", "rotationY", {
                duration: 0.9,
                ease: "power3.out",
            });
            const rotX = gsap.quickTo("#portada-escena", "rotationX", {
                duration: 0.9,
                ease: "power3.out",
            });
            const capaX = gsap.quickTo("#portada-particulas", "x", {
                duration: 1,
                ease: "power3.out",
            });
            const capaY = gsap.quickTo("#portada-particulas", "y", {
                duration: 1,
                ease: "power3.out",
            });

            const mover = (nx: number, ny: number) => {
                rotY(nx * 9);
                rotX(-ny * 7);
                capaX(nx * 26);
                capaY(ny * 26);
            };

            portada.addEventListener("pointermove", (e) => {
                mover(
                    (e.clientX / window.innerWidth) * 2 - 1,
                    (e.clientY / window.innerHeight) * 2 - 1,
                );
            });
            portada.addEventListener("pointerleave", () => mover(0, 0));

            // Inclinación del celular (Android lo da sin pedir permiso)
            const alInclinar = (e: DeviceOrientationEvent) => {
                if (e.gamma == null || e.beta == null) return;
                mover(
                    gsap.utils.clamp(-1, 1, e.gamma / 25),
                    gsap.utils.clamp(-1, 1, (e.beta - 45) / 25),
                );
            };
            window.addEventListener("deviceorientation", alInclinar);
            portada.addEventListener("portada-cerrando", () =>
                window.removeEventListener("deviceorientation", alInclinar),
            );
        }

        btnIngresar?.addEventListener("click", () => {
            portada.dispatchEvent(new CustomEvent("portada-cerrando"));

            // Reproducir música
            const audio = new Audio("/musica/melodia.mp3");
            audio.loop = true;
            audio.volume = 0.5;
            audio.play().catch((error: any) => {
                console.log("Error al reproducir audio:", error);
            });

            (window as any).audioGlobal = audio;
            (window as any).estaReproduciendoGlobal = true;

            // Avisar a NombresFlores que la portada se abrió
            (window as any).portadaAbierta = true;
            window.dispatchEvent(new CustomEvent("portada-abierta"));

            // Actualizar iconos del reproductor
            setTimeout(() => {
                const iconoPlay = document.getElementById("icono-play");
                const iconoPause = document.getElementById("icono-pause");
                if (iconoPlay && iconoPause) {
                    iconoPlay.classList.add("hidden");
                    iconoPause.classList.remove("hidden");
                }
            }, 100);

            // ═══ APERTURA 3D: los nombres vienen hacia uno, las flores se abren ═══
            gsap.killTweensOf([
                "#portada-flotante",
                "#btn-ingresar-pulso",
                "#flor-arriba",
                "#flor-abajo",
            ]);

            const salida = gsap.timeline({
                onStart: () => {
                    document.body.style.overflow = "auto";
                },
                onComplete: () => {
                    portada.remove();
                    document
                        .getElementById("nombres-flores")
                        ?.scrollIntoView({ behavior: "smooth" });
                },
            });

            salida
                .to(
                    "#btn-ingresar",
                    { scale: 0.92, duration: 0.12, yoyo: true, repeat: 1 },
                    0,
                )
                .to(
                    "#flor-arriba",
                    {
                        x: "-70%",
                        y: "-70%",
                        rotation: -20,
                        opacity: 0,
                        duration: 1,
                        ease: "power3.in",
                    },
                    0.1,
                )
                .to(
                    "#flor-abajo",
                    {
                        x: "70%",
                        y: "70%",
                        rotation: 20,
                        opacity: 0,
                        duration: 1,
                        ease: "power3.in",
                    },
                    0.1,
                )
                .to(
                    "#portada-marco",
                    {
                        z: 320,
                        rotationX: -10,
                        opacity: 0,
                        duration: 1,
                        ease: "power3.in",
                    },
                    0.15,
                )
                .to(
                    "#portada-boton-caja",
                    { opacity: 0, y: 20, duration: 0.6, ease: "power2.in" },
                    0.2,
                )
                .to(
                    "#portada-sobre .portada-esquina",
                    { opacity: 0, duration: 0.8, ease: "power2.in" },
                    0.1,
                )
                .to(
                    portada,
                    { opacity: 0, duration: 0.6, ease: "power2.out" },
                    0.8,
                );
        });
    });
</script>

<style>
    body {
        overflow: hidden;
    }

    :global(.portada-particula) {
        position: absolute;
        border-radius: 9999px;
        background: radial-gradient(
            circle,
            #efe4cc 0%,
            #c9ad7f 45%,
            rgba(201, 173, 127, 0) 75%
        );
        box-shadow: 0 0 10px 2px rgba(201, 173, 127, 0.45);
        opacity: 0.7;
    }

    /* ── Escena 3D ── */
    .portada-escena {
        transform-style: preserve-3d;
        width: 100%;
        max-width: 30rem;
    }

    .portada-flotante {
        transform-style: preserve-3d;
    }

    .portada-contenido {
        position: relative;
        transform-style: preserve-3d;
        padding: 0 1.5rem;
    }

    /* ── Separador ── */
    .portada-linea {
        display: block;
        height: 1px;
        width: clamp(3.5rem, 18vw, 5.5rem);
        background: linear-gradient(90deg, transparent, #c2a36f);
    }
    .portada-linea-der {
        background: linear-gradient(90deg, #c2a36f, transparent);
    }
    .portada-adorno {
        display: inline-flex;
        color: #c2a36f;
        filter: drop-shadow(0 0 4px rgba(194, 163, 111, 0.6));
    }
    .portada-adorno svg {
        width: 1.05rem;
        height: auto;
        fill: currentColor;
    }

    /* ── Nombres con brillo dorado en relieve ── */
    .portada-nombre {
        font-size: clamp(2.8rem, min(14vw, 8.5dvh), 4.5rem);
        background: linear-gradient(
            110deg,
            #a8874f 0%,
            #a8874f 35%,
            #c4a774 45%,
            #e2d2b0 50%,
            #c4a774 55%,
            #a8874f 65%,
            #a8874f 100%
        );
        background-size: 250% 100%;
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        filter: drop-shadow(0 2px 0 rgba(54, 67, 27, 0.18))
            drop-shadow(0 10px 14px rgba(54, 67, 27, 0.18));
        animation: portada-brillo 6s ease-in-out infinite;
        padding: 0 0.15em;
    }

    .portada-y {
        font-size: clamp(2.6rem, min(13vw, 7.5dvh), 4rem);
        background: linear-gradient(180deg, #6f8440 0%, #556b2f 55%, #3f4f20 100%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        filter: drop-shadow(0 2px 0 rgba(54, 67, 27, 0.2))
            drop-shadow(0 6px 10px rgba(54, 67, 27, 0.16));
    }

    @keyframes portada-brillo {
        0%,
        100% {
            background-position: 100% 0;
        }
        50% {
            background-position: 0% 0;
        }
    }

    /* ── Botón 3D ── */
    .portada-boton {
        position: relative;
        overflow: hidden;
        padding: 0.85rem 2rem;
        border-radius: 14px;
        color: #fff7ea;
        background: linear-gradient(180deg, #6f8440 0%, #556b2f 55%, #4f6329 100%);
        border: 1px solid rgba(255, 226, 190, 0.45);
        box-shadow:
            0 5px 0 #36431b,
            0 14px 24px -6px rgba(54, 67, 27, 0.19),
            inset 0 1px 0 rgba(255, 240, 220, 0.6);
        text-shadow: 0 1px 1px rgba(54, 67, 27, 0.2);
        transition:
            transform 0.15s ease,
            box-shadow 0.15s ease;
    }
    .portada-boton::after {
        content: "";
        position: absolute;
        top: 0;
        left: -60%;
        width: 40%;
        height: 100%;
        background: linear-gradient(
            100deg,
            transparent,
            rgba(255, 255, 255, 0.45),
            transparent
        );
        transform: skewX(-20deg);
        animation: portada-destello 3.2s ease-in-out 2.5s infinite;
    }
    .portada-boton:hover {
        transform: translateY(-2px);
        box-shadow:
            0 7px 0 #36431b,
            0 18px 28px -6px rgba(54, 67, 27, 0.19),
            inset 0 1px 0 rgba(255, 240, 220, 0.6);
    }
    .portada-boton:active {
        transform: translateY(4px);
        box-shadow:
            0 1px 0 #36431b,
            0 6px 12px -4px rgba(54, 67, 27, 0.18),
            inset 0 1px 0 rgba(255, 240, 220, 0.6);
    }

    @keyframes portada-destello {
        0% {
            left: -60%;
        }
        45%,
        100% {
            left: 130%;
        }
    }

    /* ── Flores en las esquinas ── */
    .portada-flor {
        filter: drop-shadow(0 14px 18px rgba(54, 67, 27, 0.14));
    }
    #flor-arriba {
        transform-origin: 0% 0%;
    }
    #flor-abajo {
        transform-origin: 100% 100%;
    }

    /* ── Adornos dorados de las esquinas ── */
    .portada-esquina {
        position: absolute;
        z-index: 3;
        width: clamp(70px, 20vw, 130px);
        height: auto;
        pointer-events: none;
        opacity: 0.75;
    }
    .portada-esquina path {
        stroke: #c2a36f;
        stroke-width: 1;
        stroke-linecap: round;
        stroke-dasharray: 1;
    }
    .portada-esquina path:nth-child(2) {
        stroke: rgba(194, 163, 111, 0.55);
        stroke-width: 0.6;
    }
    .portada-esquina circle {
        fill: #c2a36f;
    }
    .portada-esquina-der {
        top: 14px;
        right: 14px;
        transform: scaleX(-1);
    }
    .portada-esquina-izq {
        bottom: 14px;
        left: 14px;
        transform: scaleY(-1);
    }

    /* ── Pétalos ── */
    :global(.portada-petalo) {
        position: absolute;
        top: 0;
        opacity: 0;
        filter: drop-shadow(0 3px 4px rgba(54, 67, 27, 0.09));
    }
    :global(.portada-petalo svg) {
        width: 100%;
        height: 100%;
        display: block;
    }

    @media (prefers-reduced-motion: reduce) {
        .portada-nombre,
        .portada-boton::after {
            animation: none;
        }
    }
</style>
